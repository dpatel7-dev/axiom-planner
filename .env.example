# Copy this file to .env and fill in real values for local development
# (These are injected automatically on Render via the dashboard)

PORT=3000
NODE_ENV=development

# PostgreSQL connection string
# Local example: postgres://postgres:password@localhost:5432/axiom
DATABASE_URL=postgres://user:password@localhost:5432/axiom

# Secret used to sign JWT tokens (make this a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Owner allowlist — comma-separated usernames who can use the maintenance toggle.
# Only these users will see the maintenance panel in Settings.
OWNER_USERNAMES=

# Admin password — required as a second factor when toggling maintenance mode.
# Make this long and random. Don't share it.
ADMIN_PASSWORD=
